using sysbus
mach create
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl
$elf=@./stm32-renode_Interrput/build/lab1
macro reset
"""
       
    ## load binaries ##
    echo "PC: $(sysbus.cpu PC)"
    
    sysbus LoadELF $elf
    start

"""
logLevel -1 gpioPortD.UserLED
runMacro $reset


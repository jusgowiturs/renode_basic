int main(void)
{
    volatile uint32_t *pRCC_AHB1ENR = (volatile uint32_t *)(0x40023800 + 0x30);
    volatile uint32_t *pGPIOB_MODER = (volatile uint32_t *)(0x40020400);
    volatile uint32_t *pGPIOB_ODR    = (volatile uint32_t *)(0x40020400 + 0x14);

    // Enable GPIOB clock
    *pRCC_AHB1ENR |= (1U << 1);

